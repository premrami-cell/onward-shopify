{% comment %}
  Flavor = image only
  Quantity = text
{% endcomment %}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign option_name_downcase = option.name | downcase
  assign is_flavor = false

  if option_name_downcase == 'flavor'
    assign is_flavor = true
  endif
-%}

{%- for value in option.values -%}
  {%- liquid
    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif

    assign variant_for_value = null
    if is_flavor
      for v in product.variants
        if v.options contains value
          assign variant_for_value = v
          break
        endif
      endfor
    endif
  -%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 }}
  {%- endcapture -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  <input
    type="radio"
    id="{{ input_id }}"
    name="{{ input_name | escape }}"
    value="{{ value | escape }}"
    form="{{ product_form_id }}"
    {% if value.selected %}checked{% endif %}
    {% if option_disabled %}class="disabled"{% endif %}
    data-option-value-id="{{ value.id }}"
  >

  <label
    for="{{ input_id }}"
    class="{% if is_flavor %}flavor-image-option{% else %}pill-option{% endif %}"
  >
    {% if is_flavor %}
      {% if variant_for_value and variant_for_value.image %}
        <img
          src="{{ variant_for_value.image | image_url: width: 160 }}"
          alt="{{ value }}"
          loading="lazy"
        >
      {% endif %}
    {% else %}
      {{ value }}
    {% endif %}
  </label>

{%- endfor -%}
