{{ 'icon-box.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="icon-boxs  section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="icon-box-div">
      {% for block in section.blocks %}
        <div class="icon-box" {{ block.shopify_attributes }}>
          <div class="icon-box-details">
            {% if block.settings.icon_svg != blank %}
              <div class="icon">
                <img
                  src="{{ block.settings.icon_svg | image_url: width: 64 }}"
                  alt="{{ block.settings.title | escape }}"
                  width="32"
                  height="39"
                  loading="lazy"
                >
              </div>
            {% endif %}

            <div class="icon-details">
              {% if block.settings.title != blank %}
                <h4>{{ block.settings.title }}</h4>
              {% endif %}

              {% if block.settings.description != blank %}
                <p>{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon with text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "icon_box",
      "name": "Icon Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_svg",
          "label": "Upload SVG Icon",
          "info": "Upload SVG only for best quality"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A perfect balance"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "CBD & THC - where chill meets cheer, perfectly."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon with text",
      "blocks": [{ "type": "icon_box" }, { "type": "icon_box" }, { "type": "icon_box" }]
    }
  ]
}
{% endschema %}
