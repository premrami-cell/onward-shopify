{{ 'similar-product.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% if section.settings.collection != blank %}
  <section class="similar-product  section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
    <div class="container">
      <div class="similar-can">
        <div class="products-title">
          <h2>{{ section.settings.heading }}</h2>
        </div>

        <div class="similar-products">
          {% for product in section.settings.collection.products limit: section.settings.products_limit %}
            <a href="{{ product.url }}" class="product-card">
              <div class="product-image">
                {% if product.media.size > 0 %}
                  {% assign first_media = product.media.first %}

                  {% if first_media.media_type == 'video' %}
                    <video
                      class="hover-video"
                      muted
                      loop
                      playsinline
                      preload="none"
                    >
                      <source src="{{ first_media.sources[0].url }}" type="video/mp4">
                    </video>
                  {% endif %}

                  {% if product.featured_image %}
                    {{
                      product.featured_image
                      | image_url: width: 500
                      | image_tag: alt: product.title, loading: 'lazy'
                    }}
                  {% endif %}
                {% endif %}
              </div>

              <div class="product-title">
                {{ product.title | upcase }}
                <svg
                  width="40"
                  height="15"
                  viewBox="0 0 40 15"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M39.7071 8.07112C40.0976 7.68059 40.0976 7.04743 39.7071 6.6569L33.3431 0.292943C32.9526 -0.0975814 32.3195 -0.0975814 31.9289 0.292943C31.5384 0.683467 31.5384 1.31663 31.9289 1.70716L37.5858 7.36401L31.9289 13.0209C31.5384 13.4114 31.5384 14.0446 31.9289 14.4351C32.3195 14.8256 32.9526 14.8256 33.3431 14.4351L39.7071 8.07112ZM0 7.36401L8.74228e-08 8.36401L39 8.36401L39 7.36401L39 6.36401L-8.74228e-08 6.36401L0 7.36401Z"
                    fill="#141429" />
                </svg>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Recommendation product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customers Also Like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Products collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Recommendation product"
    }
  ]
}
{% endschema %}
