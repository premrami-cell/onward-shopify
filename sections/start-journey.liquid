{{ 'start-journey.css' | asset_url | stylesheet_tag }}

<section class="start-journey  color-scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="startjourney-content">
      <!-- LEFT CONTENT -->
      <div class="journey-left">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.description }}</p>
      </div>

      <!-- RIGHT SLIDER -->
      <div class="journey-right">
        <div class="journey-product swiper">
          <div class="swiper-wrapper">
            {% for product in collections[section.settings.collection].products %}
              <div class="swiper-slide journey-slide">
                <a href="{{ product.url }}" class="journey-card">
                  <div class="journey-image">
                    {% if product.featured_image %}
                      {{
                        product.featured_image
                        | image_url: width: 600
                        | image_tag: alt: product.title, loading: 'lazy'
                      }}
                    {% endif %}
                  </div>

                  <div class="journey-title">
                    {{ product.title }}
                    <svg
                      width="40"
                      height="15"
                      viewBox="0 0 40 15"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                          d="M39.7071 8.07112C40.0976 7.68059 40.0976 7.04743 39.7071 6.6569L33.3431 0.292943C32.9526 -0.0975814 32.3195 -0.0975814 31.9289 0.292943C31.5384 0.683467 31.5384 1.31663 31.9289 1.70716L37.5858 7.36401L31.9289 13.0209C31.5384 13.4114 31.5384 14.0446 31.9289 14.4351C32.3195 14.8256 32.9526 14.8256 33.3431 14.4351L39.7071 8.07112ZM0 7.36401L8.74228e-08 8.36401L39 8.36401L39 7.36401L39 6.36401L-8.74228e-08 6.36401L0 7.36401Z"
                          fill="#141429" />
                    </svg>
                  </div>
                </a>
              </div>
            {% endfor %}
          </div>
        </div>

        <!-- CUSTOM NEXT ARROW -->
        <button class="journey-next-arrow">
          <svg
            width="40"
            height="15"
            viewBox="0 0 40 15"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
                d="M39.7071 8.07112C40.0976 7.68059 40.0976 7.04743 39.7071 6.6569L33.3431 0.292943C32.9526 -0.0975814 32.3195 -0.0975814 31.9289 0.292943C31.5384 0.683467 31.5384 1.31663 31.9289 1.70716L37.5858 7.36401L31.9289 13.0209C31.5384 13.4114 31.5384 14.0446 31.9289 14.4351C32.3195 14.8256 32.9526 14.8256 33.3431 14.4351L39.7071 8.07112ZM0 7.36401L8.74228e-08 8.36401L39 8.36401L39 7.36401L39 6.36401L-8.74228e-08 6.36401L0 7.36401Z"
                fill="#B3B3B3" />
          </svg>
        </button>
      </div>
      {% if section.settings.shop_all_link != blank %}
          <a href="{{ section.settings.shop_all_link }}" class="shop">
            {{ section.settings.shop_all_text }}
            <svg
              width="40"
              height="15"
              viewBox="0 0 40 15"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                  d="M39.7071 8.07112C40.0976 7.68059 40.0976 7.04743 39.7071 6.6569L33.3431 0.292943C32.9526 -0.0975814 32.3195 -0.0975814 31.9289 0.292943C31.5384 0.683467 31.5384 1.31663 31.9289 1.70716L37.5858 7.36401L31.9289 13.0209C31.5384 13.4114 31.5384 14.0446 31.9289 14.4351C32.3195 14.8256 32.9526 14.8256 33.3431 14.4351L39.7071 8.07112ZM0 7.36401L8.74228e-08 8.36401L39 8.36401L39 7.36401L39 6.36401L-8.74228e-08 6.36401L0 7.36401Z"
                  fill="#141429" />
            </svg>
          </a>
        {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Start Journey Slider",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start your Journey"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Begin your experience with the ultimate sampler."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product Collection"
    },
         {
      "type": "text",
      "id": "shop_all_text",
      "label": "Shop all text",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop all link"
    },
  ],
  "presets": [
    {
      "name": "Start Journey Slider"
    }
  ]
}
{% endschema %}
