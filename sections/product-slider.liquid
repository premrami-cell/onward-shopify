{{ 'product-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="color-{{ section.settings.color_scheme }} own-path section-{{ section.id }}-padding">
  <div class="container">
    <div class="ownpath-content">
      <!-- Top heading -->
      <div class="own-upper">
        <h3>{{ section.settings.heading }}</h3>

        {% if section.settings.show_view_all == true and section.settings.collection != blank %}
          <a href="{{ section.settings.collection.url }}" class="shop">
            {{ section.settings.shop_all_text }}
            <svg width="40" height="15" viewBox="0 0 40 15" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M39.7071 8.07112C40.0976 7.68059 40.0976 7.04743 39.7071 6.6569L33.3431 0.292943C32.9526 -0.0975814 32.3195 -0.0975814 31.9289 0.292943C31.5384 0.683467 31.5384 1.31663 31.9289 1.70716L37.5858 7.36401L31.9289 13.0209C31.5384 13.4114 31.5384 14.0446 31.9289 14.4351C32.3195 14.8256 32.9526 14.8256 33.3431 14.4351L39.7071 8.07112ZM0 7.36401H39V6.36401H0V7.36401Z" fill="#141429"/>
            </svg>
          </a>
        {% endif %}
      </div>

      <!-- Slider -->
      <div class="own-bottom">
        <div class="product-slider-wrapper">
          <button class="slider-arrow prev">
            <svg width="44" height="15" viewBox="0 0 44 15" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.292893 6.6569C-0.0976295 7.04743 -0.0976296 7.68059 0.292892 8.07111L6.65685 14.4351C7.04738 14.8256 7.68054 14.8256 8.07107 14.4351C8.46159 14.0446 8.46159 13.4114 8.07107 13.0209L2.41422 7.36401L8.07107 1.70715C8.46159 1.31663 8.46159 0.683466 8.07107 0.292941C7.68054 -0.0975831 7.04738 -0.0975832 6.65685 0.292941L0.292893 6.6569ZM44 7.36401H1V6.36401H44V7.36401Z" fill="white"/>
            </svg>
          </button>

          <div class="product-slider swiper">
            <div class="swiper-wrapper">
              {% assign limit = section.settings.products_limit | default: 6 %}

              {% if section.settings.collection != blank %}
                {% for product in section.settings.collection.products limit: limit %}
                  <div class="swiper-slide">
                    <a href="{{ product.url }}" class="product-card">
                      <div class="product-image">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            alt="{{ product.title | escape }}"
                            loading="lazy"
                          >
                        {% endif %}
                      </div>

                      <div class="product-title">
                        {{ product.title }}
                        <svg width="46" height="15" viewBox="0 0 46 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M45.5437 8.07088C45.9342 7.68036 45.9342 7.04719 45.5437 6.65667L39.1797 0.292705C38.7892 -0.0978193 38.1561 -0.0978193 37.7655 0.292705C37.375 0.683229 37.375 1.31639 37.7655 1.70692L43.4224 7.36377L37.7655 13.0206C37.375 13.4112 37.375 14.0443 37.7655 14.4348C38.1561 14.8254 38.7892 14.8254 39.1797 14.4348L45.5437 8.07088Z" fill="#141429"/>
                        </svg>
                      </div>
                    </a>
                  </div>
                {% endfor %}

              {% else %}
                {% for i in (1..limit) %}
                  <div class="swiper-slide">
                    <div class="product-card is-placeholder">
                      <div class="product-image">
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>

                      <div class="product-title">
                        Dummy Product {{ i }}
                        <svg width="34" height="15" viewBox="0 0 34 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M33.7071 8.07112C34.0976 7.68059 34.0976 7.04743 33.7071 6.6569L27.3431 0.292943C26.9526 -0.0975809 26.3195 -0.0975808 25.9289 0.292944C25.5384 0.683468 25.5384 1.31663 25.9289 1.70716L31.5858 7.36401L25.9289 13.0209C25.5384 13.4114 25.5384 14.0446 25.9289 14.4351C26.3195 14.8256 26.9526 14.8256 27.3431 14.4351L33.7071 8.07112ZM0 7.36401L8.74228e-08 8.36401L33 8.36401L33 7.36401L33 6.36401L-8.74228e-08 6.36401L0 7.36401Z" fill="white"></path>
                        </svg>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <button class="slider-arrow next">
            <svg width="44" height="15" viewBox="0 0 44 15" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M43.7071 8.07113C44.0976 7.68061 44.0976 7.04744 43.7071 6.65692L37.3431 0.292954C36.9526 -0.0975706 36.3195 -0.0975708 35.9289 0.292954C35.5384 0.683478 35.5384 1.31664 35.9289 1.70717L41.5858 7.36402L35.9289 13.0209C35.5384 13.4114 35.5384 14.0446 35.9289 14.4351C36.3195 14.8256 36.9526 14.8256 37.3431 14.4351L43.7071 8.07113ZM0 7.36401H43V6.36401H0V7.36401Z" fill="white"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Take your Own Path"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "shop_all_text",
      "label": "View All",
      "default": "SHOP ALL"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Product Slider"
    }
  ]
}
{% endschema %}
