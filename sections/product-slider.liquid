{{ 'product-slider.css' | asset_url | stylesheet_tag }}

<section class="color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="ownpath-content">
      <!-- Top heading -->
      <div class="own-upper">
        <h3>{{ section.settings.heading }}</h3>

        {% if section.settings.shop_all_link != blank %}
          <a href="{{ section.settings.shop_all_link }}" class="shop">
            {{ section.settings.shop_all_text }}
            <svg
              width="40"
              height="15"
              viewBox="0 0 40 15"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                  d="M39.7071 8.07112C40.0976 7.68059 40.0976 7.04743 39.7071 6.6569L33.3431 0.292943C32.9526 -0.0975814 32.3195 -0.0975814 31.9289 0.292943C31.5384 0.683467 31.5384 1.31663 31.9289 1.70716L37.5858 7.36401L31.9289 13.0209C31.5384 13.4114 31.5384 14.0446 31.9289 14.4351C32.3195 14.8256 32.9526 14.8256 33.3431 14.4351L39.7071 8.07112ZM0 7.36401L8.74228e-08 8.36401L39 8.36401L39 7.36401L39 6.36401L-8.74228e-08 6.36401L0 7.36401Z"
                  fill="#141429" />
            </svg>
          </a>
        {% endif %}
      </div>

      <!-- Slider -->
      <div class="own-bottom">
        <div class="product-slider-wrapper">
          <button class="slider-arrow prev">
            <svg
              width="44"
              height="15"
              viewBox="0 0 44 15"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                  d="M0.292893 6.6569C-0.0976295 7.04743 -0.0976296 7.68059 0.292892 8.07111L6.65685 14.4351C7.04738 14.8256 7.68054 14.8256 8.07107 14.4351C8.46159 14.0446 8.46159 13.4114 8.07107 13.0209L2.41422 7.36401L8.07107 1.70715C8.46159 1.31663 8.46159 0.683466 8.07107 0.292941C7.68054 -0.0975831 7.04738 -0.0975832 6.65685 0.292941L0.292893 6.6569ZM44 7.36401L44 6.36401L1 6.36401L1 7.36401L1 8.36401L44 8.36401L44 7.36401Z"
                  fill="white" />
            </svg>
          </button>

          <div class="product-slider swiper">
            <div class="swiper-wrapper">
              {% for product in section.settings.collection.products %}
                <div class="swiper-slide">
                  <a href="{{ product.url }}" class="product-card">
                    <div class="product-image">
                      {%- assign hover_video = null -%}
                      {% for media in product.media %}
                        {% if media.media_type == 'video' %}
                          {% assign hover_video = media %}
                          {% break %}
                        {% endif %}
                      {% endfor %}

                      {% if hover_video %}
                        <video
                          class="hover-video"
                          muted
                          loop
                          playsinline
                          preload="none"
                        >
                          <source
                            src="{{ hover_video.sources[0].url }}"
                            type="video/mp4"
                          >
                        </video>
                      {% endif %}

                      {% if product.featured_image %}
                        <img
                          src="{{ product.featured_image | image_url: width: 600 }}"
                          alt="{{ product.title | escape }}"
                          loading="lazy"
                        >
                      {% endif %}
                    </div>

                    <div class="product-title">
                      {{ product.title }}
                      <svg width="46" height="15" viewBox="0 0 46 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M45.5437 8.07088C45.9342 7.68036 45.9342 7.04719 45.5437 6.65667L39.1797 0.292705C38.7892 -0.0978193 38.1561 -0.0978193 37.7655 0.292705C37.375 0.683229 37.375 1.31639 37.7655 1.70692L43.4224 7.36377L37.7655 13.0206C37.375 13.4112 37.375 14.0443 37.7655 14.4348C38.1561 14.8254 38.7892 14.8254 39.1797 14.4348L45.5437 8.07088ZM0 7.36377L-8.74228e-08 8.36377L44.8366 8.36377L44.8366 7.36377L44.8366 6.36377L8.74228e-08 6.36377L0 7.36377Z" fill="#141429"></path>
                      </svg>
                    </div>
                  </a>
                </div>
              {% endfor %}
            </div>
          </div>

          <button class="slider-arrow next">
            <svg
              width="44"
              height="15"
              viewBox="0 0 44 15"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                  d="M43.7071 8.07113C44.0976 7.68061 44.0976 7.04744 43.7071 6.65692L37.3431 0.292954C36.9526 -0.0975706 36.3195 -0.0975708 35.9289 0.292954C35.5384 0.683478 35.5384 1.31664 35.9289 1.70717L41.5858 7.36402L35.9289 13.0209C35.5384 13.4114 35.5384 14.0446 35.9289 14.4351C36.3195 14.8256 36.9526 14.8256 37.3431 14.4351L43.7071 8.07113ZM0 7.36401L-2.13474e-07 8.36401L43 8.36402L43 7.36402L43 6.36402L2.13474e-07 6.36401L0 7.36401Z"
                  fill="white" />
            </svg>
          </button>
        </div>
      </div>

      {% if section.settings.shop_all_link != blank %}
        <a href="{{ section.settings.shop_all_link }}" class="shop2">
          {{ section.settings.shop_all_text }}
          <svg
            width="108"
            height="15"
            viewBox="0 0 108 15"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
                d="M107.707 8.07112C108.098 7.6806 108.098 7.04743 107.707 6.65691L101.343 0.292946C100.953 -0.0975785 100.319 -0.0975785 99.9289 0.292946C99.5384 0.68347 99.5384 1.31664 99.9289 1.70716L105.586 7.36401L99.9289 13.0209C99.5384 13.4114 99.5384 14.0446 99.9289 14.4351C100.319 14.8256 100.953 14.8256 101.343 14.4351L107.707 8.07112ZM0 7.36401V8.36401H107V7.36401V6.36401H0V7.36401Z"
                fill="white" />
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Own Path – Product Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Take your Own Path"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "text",
      "id": "shop_all_text",
      "label": "Shop all text",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop all link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
     {
      "type": "text",
      "id": "shop_text",
      "label": "Button text",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Own Path Product Slider"
    }
  ]
}
{% endschema %}
